doctype html
html(lang="ja")
  head
    meta(charset="utf-8")
    title ダブルス スコアシート
  body
    h1 #{teamA} 対 #{teamB}
    p #{scoreA} - #{scoreB}
    if winner
      p #{winner} の勝ち
      a(href="/") 新しい試合を始める
    else
      form(method="post" action=`/matches/${id}/points`)
        button(type="submit" name="team" value="A") #{teamA} ＋1
        button(type="submit" name="team" value="B") #{teamB} ＋1
    form(method="post" action=`/matches/${id}/undo`)
      button(type="submit") 1点戻す
