doctype html
html(lang="ja")
  head
    meta(charset="utf-8")
    title ダブルス スコアシート
  body
    h1 #{teamA} 対 #{teamB}
    p #{scoreA} - #{scoreB}
    form(method="post" action=`/matches/${id}/points`)
      button(type="submit" name="team" value="A") #{teamA} ＋1
      button(type="submit" name="team" value="B") #{teamB} ＋1
